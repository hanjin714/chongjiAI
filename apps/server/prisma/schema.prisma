generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Tenant {
  id          String       @id @default(uuid())
  name        String
  ownerName   String
  ownerPhone  String
  plan        String       @default("basic")
  status      String       @default("ACTIVE")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  stores      Store[]
  users       User[]
  pets        Pet[]
  customers   Customer[]
  salesOrders SalesOrder[]
  tasks       Task[]
  packages    Package[]
  auditLogs   AuditLog[]

  @@index([ownerPhone])
  @@index([status])
}

model Store {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  city      String?
  address   String?
  phone     String?
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users     User[]
  pets      Pet[]
  customers Customer[]
  salesOrders SalesOrder[]
  tasks     Task[]
  packages  Package[]

  @@index([tenantId])
}

model User {
  id            String   @id @default(uuid())
  tenantId      String
  storeId       String?
  name          String
  phone         String
  role          String
  active        Boolean  @default(true)
  workWechatId  String?
  passwordHash  String?
  isDemo        Boolean  @default(false)
  lastLoginAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store         Store?   @relation(fields: [storeId], references: [id], onDelete: SetNull)
  assignedTasks Task[]   @relation("TaskAssignee")
  createdPets   Pet[]    @relation("PetCreator")
  soldOrders    SalesOrder[] @relation("SalesOrderSeller")

  @@index([phone])
  @@index([tenantId, role])
  @@index([storeId])
}

model Pet {
  id                String     @id @default(uuid())
  tenantId          String
  storeId           String
  publicId          String
  microchipId       String?
  name              String?
  species           String
  breed             String
  birthday          DateTime?
  gender            String
  color             String?
  healthStatus      String     @default("HEALTHY")
  defects           String?
  vaccineStatus     String?
  lastVaccineDate   DateTime?
  source            String?
  purchasePrice     Float?
  purchaseDate      DateTime?
  salePrice         Float?
  status            String     @default("TRANSIT")
  currentCustomerId String?
  reservedByUserId  String?
  reservedAt        DateTime?
  soldOrderId       String?
  feishuRecordId    String?
  feishuSyncStatus  String     @default("PENDING")
  feishuSyncError   String?
  feishuSyncedAt    DateTime?
  createdByUserId   String
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  deletedAt         DateTime?

  tenant          Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store           Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdBy       User       @relation("PetCreator", fields: [createdByUserId], references: [id])
  photos          PetPhoto[]
  logs            PetLog[]
  salesOrders     SalesOrder[]
  customerPets    CustomerPet[]
  tasks           Task[]

  @@index([tenantId, storeId, status])
  @@index([tenantId, species])
  @@index([tenantId, breed])
  @@index([feishuSyncStatus])
}

model PetPhoto {
  id              String   @id @default(uuid())
  tenantId        String
  petId           String
  url             String
  storageKey      String
  type            String   @default("PROFILE")
  uploadedByUserId String?
  createdAt       DateTime @default(now())

  pet    Pet @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@index([petId])
  @@index([tenantId, type])
}

model Customer {
  id                String    @id @default(uuid())
  tenantId          String
  storeId           String
  name              String
  phone             String
  wechatId          String?
  birthday          DateTime?
  address           String?
  source            String?
  ownerSalesId      String?
  lifecycleStage    String?
  segment           String?
  lastInteractionAt DateTime?
  nextFollowUpAt    DateTime?
  riskLevel         String    @default("NONE")
  notes             String?
  feishuRecordId    String?
  feishuSyncStatus  String    @default("PENDING")
  feishuSyncedAt    DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant     Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store      Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customerPets CustomerPet[]
  salesOrders  SalesOrder[]
  tasks        Task[]

  @@index([tenantId, storeId])
  @@index([tenantId, ownerSalesId])
  @@index([tenantId, phone])
  @@index([riskLevel])
}

model CustomerPet {
  id           String   @id @default(uuid())
  tenantId     String
  customerId   String
  petId        String
  relationType String   @default("OWNER")
  startedAt    DateTime @default(now())
  endedAt      DateTime?

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  pet      Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([petId])
}

model SalesOrder {
  id                 String           @id @default(uuid())
  tenantId           String
  storeId            String
  petId              String
  customerId         String
  soldByUserId       String
  soldByUserName     String
  managedByWorkWechat String?
  soldPrice          Float
  suppliesPrice      Float            @default(0)
  warrantyDays       Int              @default(30)
  soldDate           DateTime
  status             String           @default("COMPLETED")
  feishuRecordId     String?
  feishuSyncStatus   String           @default("PENDING")
  feishuSyncError    String?
  feishuSyncedAt     DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store        Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  pet          Pet        @relation(fields: [petId], references: [id])
  customer     Customer   @relation(fields: [customerId], references: [id])
  soldBy       User       @relation("SalesOrderSeller", fields: [soldByUserId], references: [id])
  contractFiles ContractFile[]

  @@index([tenantId, storeId])
  @@index([tenantId, soldByUserId])
  @@index([petId])
  @@index([customerId])
  @@index([feishuSyncStatus])
}

model ContractFile {
  id                String   @id @default(uuid())
  tenantId          String
  salesOrderId      String
  petId             String
  customerId        String
  url               String
  storageKey        String
  feishuFileToken   String?
  uploadedByUserId  String
  uploadedAt        DateTime @default(now())
  createdAt         DateTime @default(now())

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)

  @@index([salesOrderId])
  @@index([petId])
}

model PetLog {
  id                    String   @id @default(uuid())
  tenantId              String
  storeId               String
  petId                 String
  operatorUserId        String
  operatorName          String
  type                  String
  content               String
  healthStatusSnapshot  String?
  occurredAt            DateTime @default(now())
  feishuRecordId        String?
  feishuSyncStatus      String   @default("PENDING")
  createdAt             DateTime @default(now())

  pet Pet @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@index([petId, occurredAt])
  @@index([tenantId, type])
  @@index([feishuSyncStatus])
}

model Task {
  id                 String     @id @default(uuid())
  tenantId           String
  storeId            String?
  assigneeUserId     String
  relatedPetId       String?
  relatedCustomerId  String?
  type               String
  priority           String
  title              String
  reason             String
  suggestedContent   String?
  dueDate            DateTime
  status             String     @default("TODO")
  result             String?
  completedAt        DateTime?
  source             String     @default("AI")
  feishuRecordId     String?
  feishuSyncStatus   String     @default("PENDING")
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  assignee         User     @relation("TaskAssignee", fields: [assigneeUserId], references: [id])
  relatedPet       Pet?     @relation(fields: [relatedPetId], references: [id])
  relatedCustomer  Customer? @relation(fields: [relatedCustomerId], references: [id])
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store            Store?   @relation(fields: [storeId], references: [id], onDelete: SetNull)

  @@index([tenantId, assigneeUserId, dueDate])
  @@index([tenantId, status])
  @@index([relatedCustomerId])
  @@index([relatedPetId])
}

model Package {
  id              String   @id @default(uuid())
  tenantId        String
  storeId         String?
  name            String
  description     String?
  items           String?
  originalPrice   Float
  salePrice       Float
  stock           Int      @default(0)
  expiryDate      DateTime?
  imageUrl        String?
  isPromotional   Boolean  @default(false)
  feishuRecordId  String?
  feishuSyncStatus String  @default("PENDING")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store  Store?  @relation(fields: [storeId], references: [id], onDelete: SetNull)

  @@index([tenantId, storeId])
  @@index([isPromotional])
  @@index([expiryDate])
}

model AuditLog {
  id          String   @id @default(uuid())
  tenantId    String
  storeId     String?
  actorUserId String
  actorRole   String
  action      String
  objectType  String
  objectId    String?
  beforeData  String?
  afterData   String?
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([action])
  @@index([objectType, objectId])
}

model AiConversation {
  id          String   @id @default(uuid())
  tenantId    String
  storeId     String?
  userId      String
  roleContext String
  title       String?
  dataScope   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  messages AiMessage[]

  @@index([tenantId, userId])
}

model AiMessage {
  id                String   @id @default(uuid())
  conversationId    String
  tenantId          String
  sender            String
  content           String
  intent            String?
  usedTools         String?
  referencedObjects String?
  createdAt         DateTime @default(now())

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model FeishuIntegration {
  id                String   @id @default(uuid())
  tenantId          String   @unique
  appId             String?
  tenantKey         String
  openId            String?
  unionId           String?
  accessToken       String?
  refreshToken      String?
  tokenExpiresAt    DateTime?
  status            String   @default("ACTIVE")
  authorizedByUserId String
  authorizedAt      DateTime @default(now())
  lastTestAt        DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([tenantId])
}

model FeishuTableMapping {
  id           String   @id @default(uuid())
  tenantId     String
  bizObject    String
  appToken     String
  tableId      String
  fieldMappings String?
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId])
}

model SyncEvent {
  id           String   @id @default(uuid())
  tenantId     String
  bizObject    String
  bizId        String
  action       String
  target       String   @default("FEISHU")
  status       String   @default("PENDING")
  retryCount   Int      @default(0)
  nextRetryAt  DateTime?
  payload      String?
  errorMessage String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status, nextRetryAt])
  @@index([tenantId, bizObject, bizId])
}

model SyncLog {
  id              String   @id @default(uuid())
  tenantId        String
  syncEventId     String?
  bizObject       String
  bizId           String
  action          String
  target          String
  status          String
  requestPayload  String?
  responsePayload String?
  errorMessage    String?
  startedAt       DateTime @default(now())
  finishedAt      DateTime?

  @@index([tenantId, startedAt])
  @@index([status])
  @@index([bizObject, bizId])
}
